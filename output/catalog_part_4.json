season_count":0,"streams":[],"episodes":[],"dubs":[]},{"id":"3412728269056132432","title":"Above the Line","type":"series","category":"series","year":"2014","poster":"https://pbcdn.aoneroom.com/image/2023/08/12/f58ee25d479c36070e172639624feab2.jpg","description":"Hosts AJ Mandeville and Ryan Wydeveld take you on a fun-filled trip through Indywood, the bustling world of independent film thriving in Northern California. Above the Line features segments like \"Pints and the Pipeline\", where our hosts get to know up-and-coming projects and talent over an ice cold pint of locally brewed beer; \"Martini Shots\", where we enjoy a hand-crafted martini with Producers and Directors as their projects wrap; \"Chewing the Scene\", in which we sit down one-on-one with actors to discuss especially powerful or talented scenes and their process of bringing them to life; and \"All Set Up\", a DIY series about the secrets of movie magic.","rating":null,"director":null,"cast":null,"genres":null,"duration":"","season_count":0,"streams":[],"episodes":[],"dubs":[]},{"id":"6146813739980442296","title":"Wild Women of Burlesque","type":"movie","category":"movies","year":"2023","poster":"https://pbcdn.aoneroom.com/image/2023/08/11/5403d2b8c9d2eda11aad7a1827467d10.jpg","description":"Wild Women of Burlesque is a TV series about Modern Lady Gangsters. Directed and Written by Georgette Dante, starring Georgette Dante, Stephanie Castellone, Dave Williams, Neil Kendall, Paul Vato, Dusty Summers, Ron Garrett","rating":null,"director":null,"cast":null,"genres":null,"duration":"1h 0m","season_count":0,"streams":[],"episodes":[],"dubs":[]},{"id":"6288841505230995408","title":"Pan-Poly","type":"series","category":"series","year":"2019","poster":"https://pbcdn.aoneroom.com/image/2023/08/10/e54ef50cba988a9f6ccd25572b2b2696.jpg","description":null,"rating":null,"director":null,"cast":null,"genres":null,"duration":"","season_count":0,"streams":[],"episodes":[],"dubs":[]},{"id":"1003473167593128784","title":"Thanks to Her","type":"movie","category":"movies","year":"2022","poster":"https://pbcdn.aoneroom.com/image/2023/08/11/5b7e7c47f1cc923a77a8da4cfc4a8a8c.jpg","description":"THANKS TO HER tells the story of Millie Blake, a high school soccer star who feels like she doesn't quite fit in with her popular friends. After trying to break up a fight with another student Andy Wellick, who is outspoken about her identity as a lesbian on the asexual spectrum, both girls land themselves with community service at a local nursing home. Initially, they butt heads, but the tension quickly blossoms into friendship as they learn more about each other. As time goes on and Millie's friendship with Andy grows into something more, she finds herself trying to find the courage to finally show her true self to her friends and family. This coming of age, all-inclusive LGBTQ+ film focuses on the self, sexuality, and how that plays out in one's community.","rating":null,"director":null,"cast":null,"genres":null,"duration":"1h 22m","season_count":0,"streams":[],"episodes":[],"dubs":[]},{"id":"1981585517523125328","title":"Crimes of Maintenance","type":"series","category":"series","year":"2020","poster":"https://pbcdn.aoneroom.com/image/2023/08/11/925247e7532561765d85eef09ed6f07a.jpg","description":null,"rating":null,"director":null,"cast":null,"genres":null,"duration":"","season_count":0,"streams":[],"episodes":[],"dubs":[]},{"id":"632156608834978424","title":"Goujii Gammath","type":"movie","category":"movies","year":"2023","poster":"https://pbcdn.aoneroom.com/image/2026/01/26/6194bd31b1e3d837041c094f93f73c83.jpg","description":"A father's frugal ways annoy his family, especially his daughter. His apparent stinginess creates comedy and conflict until his sacrifices become clear at her wedding, highlighting their special bond.","rating":"9.0","director":null,"cast":null,"genres":null,"duration":"2h 14m","season_count":0,"streams":[],"episodes":[],"dubs":[]},{"id":"979166182970478432","title":"