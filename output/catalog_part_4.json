NT, pangarap at tinig ang alaga niya sa performance.\n\n#ItsShowtimeOnline \n#ItsShowtimeFullEpisode \n#ABSCBNEntertainment\n#ShowtimeDeMayo","rating":null,"director":null,"cast":null,"genres":null,"duration":"","season_count":0,"streams":[{"quality":"360p","url":"https://bcdn.hakunaymatata.com/resource/cff4e632cdf2dba16c7af73214436b43.mp4?sign=0e04b939c41954a4637e99039ae56a01&t=1795692405","format":"mp4","codec":"h264","size":"428404386","season":null,"episode":0},{"quality":"480p","url":"https://bcdn.hakunaymatata.com/resource/390d29c2abe6388a04dc958fbc5bd584.mp4?sign=2d47252746fbdcb3e0969f2d7e5cbf6e&t=1795692405","format":"mp4","codec":"h264","size":"717688403","season":null,"episode":0},{"quality":"360p","url":"https://bcdn4.hakunaymatata.com/resource/cff4e632cdf2dba16c7af73214436b43.mp4?sign=cbb26965c181707e378df12f9e3a3c84&t=1795692406","format":"mp4","codec":"h264","size":"428404386","headers":{"Referer":"https://sportslive.wine","User-Agent":"com.community.oneroom/50020119 (Linux; U; Android 11; en_US; M2007J20CG; Build/RP1A.200720.011; Cronet/135.0.7012.3)"},"season":null,"episode":null},{"quality":"480p","url":"https://bcdn4.hakunaymatata.com/resource/390d29c2abe6388a04dc958fbc5bd584.mp4?sign=7d4b94e3ac116d355be07ab46cdeeb2b&t=1795692406","format":"mp4","codec":"h264","size":"717688403","headers":{"Referer":"https://sportslive.wine","User-Agent":"com.community.oneroom/50020119 (Linux; U; Android 11; en_US; M2007J20CG; Build/RP1A.200720.011; Cronet/135.0.7012.3)"},"season":null,"episode":null},{"quality":"360p","url":"https://bcdn.hakunaymatata.com/resource/cff4e632cdf2dba16c7af73214436b43.mp4?sign=e0357d75e2b8d5999aa30b828271f5f2&t=1795692393","format":"mp4","codec":"h264","size":"428404386","season":null,"episode":0},{"quality":"480p","url":"https://bcdn.hakunaymatata.com/resource/390d29c2abe6388a04dc958fbc5bd584.mp4?sign=5a7a1ab57f8794c2ac4c0ddca0cbbe36&t=1795692393","format":"mp4","codec":"h264","size":"717688403","season":null,"episode":0}],"episodes":