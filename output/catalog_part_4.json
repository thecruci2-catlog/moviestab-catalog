ervous Keiichi are enjoying themselves, Urd and Skuld are developing a counter-plan.","rating":"7.3","director":null,"cast":null,"genres":null,"duration":"","season_count":0,"streams":[{"quality":"360p","url":"https://bcdn.hakunaymatata.com/animekai/d3cb14168fe3234e5d25bdabcaffd5e9.mp4?sign=1d94350ab8779af4f147079223d0623c&t=1795688855","format":"mp4","codec":"h264","size":"71283989","season":3,"episode":1},{"quality":"360p","url":"https://bcdn.hakunaymatata.com/animekai/69347a5d8fef965bd813f1006f1c78c1.mp4?sign=eb3ff9ba9cba7c2d10af8da09ca5c907&t=1795688855","format":"mp4","codec":"h264","size":"101166520","season":3,"episode":2},{"quality":"360p","url":"https://bcdn.hakunaymatata.com/animekai/e044c87fa25633aa07df49cc744a059e.mp4?sign=8fee048215bdf3deadf2a9d6a24896a1&t=1795688855","format":"mp4","codec":"h264","size":"76637427","season":3,"episode":3}],"episodes":[{"season":3,"episode":1,"streams":[{"quality":"360p","url":"https://bcdn4.hakunaymatata.com/animekai/d3cb14168fe3234e5d25bdabcaffd5e9.mp4?sign=b13578fca85a82b5fc0b643a06423c35&t=1795691416","format":"mp4","codec":"h264","size":"71283989","headers":{"Referer":"https://sportslive.wine","User-Agent":"com.community.oneroom/50020119 (Linux; U; Android 11; en_US; M2007J20CG; Build/RP1A.200720.011; Cronet/135.0.7012.3)"},"season":3,"episode":1},{"quality":"480p","url":"https://bcdn4.hakunaymatata.com/animekai/121aacc6f1e1ca91a31d41a2f352cde4.mp4?sign=f425b55f8440a6faacf5dfc6e0b6df96&t=1795691416","format":"mp4","codec":"h264","size":"92634934","headers":{"Referer":"https://sportslive.wine","User-Agent":"com.community.oneroom/50020119 (Linux; U; Android 11; en_US; M2007J20CG; Build/RP1A.200720.011; Cronet/135.0.7012.3)"},"season":3,"episode":1}]},{"season":3,"episode":2,"streams":[{"quality":"360p","url":"https://bcdn4.hakunaymatata.com/animekai/69347a5d8fef965bd813f1006f1c78c1.mp4?sign=4b0ad346c017a0b4ef9cb978e4203ea0&t=1795691416","format":"mp4","codec":"h264","size":"101166520","headers":{"Referer":"https://spo