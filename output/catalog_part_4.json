p","url":"https://bcdn.hakunaymatata.com/bt/90c9630708cde4a8ca1f92e3087bf940.mp4?sign=e4d07da546c133093159f383eb7cb242&t=1795677418","format":"mp4","codec":"h264","size":"841228998","season":0,"episode":0},{"quality":"1080p","url":"https://bcdn.hakunaymatata.com/resource/db0c85ae842b808d0b4709c3828a7726.mp4?sign=ba3575c880d8a81492f1b60f75801ded&t=1795677418","format":"mp4","codec":"h264","size":"2657914287","season":0,"episode":0}],"episodes":[],"dubs":[{"subject_id":"5323238024212267312","language":"Original Audio","label":"Original Audio"},{"subject_id":"1449997761578943968","language":"Arabic sub","label":"Arabic sub"},{"subject_id":"4127186197099807120","language":"Hindi dub","label":"Hindi dub"},{"subject_id":"380836405309761232","language":"Malayalam dub","label":"Malayalam dub"},{"subject_id":"744783550196731272","language":"Tamil dub","label":"Tamil dub"},{"subject_id":"4785638315854814488","language":"Telugu dub","label":"Telugu dub"}]},{"id":"3314089981416718568","title":"Avatar 5","type":"movie","category":"movies","year":"2031","poster":"https://pbcdn.aoneroom.com/image/2026/01/27/186b7dd521ce96bc4df6e1d4466d46e8.jpg","description":"Sequel of Avatar 4 (2029) and last movie of the \"Avatar\" saga. The plot is unknown.","rating":"6.8","director":null,"cast":null,"genres":null,"duration":"","season_count":0,"streams":[],"episodes":[],"dubs":[]}]
